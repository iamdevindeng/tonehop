    "audio.duplicate_identifiers": {
      "comment": "User-facing text in ToneHop/Sources/Services/CoreAudioService.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
