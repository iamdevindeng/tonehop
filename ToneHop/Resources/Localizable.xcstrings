    "audio.exit_stream_changed": {
      "comment": "User-facing text in ToneHop/Sources/Services/AudioExitCoordinator.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous audio stream changed. Output and cleanup were left unchanged. Quit again to confirm."
          }
