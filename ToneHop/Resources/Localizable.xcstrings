{
  "sourceLanguage": "en",
  "strings": {
    "audio.airplay_identity_ambiguous": {
      "comment": "User-facing text in ToneHop/Sources/Services/PrivateRouteEvidence.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some AirPlay devices cannot be identified and are temporarily unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 AirPlay 设备身份不明确，暂不可选择。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.airplay_preparation": {
      "comment": "User-facing text in ToneHop/Sources/Services/RetainedRouteCapability.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep ToneHop running and select this device once in the macOS Sound menu to enable switching during this session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 ToneHop 运行，在 macOS「声音」菜单中选择一次此设备，即可在本次运行期间切换。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.airplay_switch_timeout": {
      "comment": "User-facing text in ToneHop/Sources/Services/PrivateRouteService.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay switching timed out. The system did not confirm the target device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPlay 切换超时，系统未确认目标设备。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.click_to_switch": {
      "comment": "User-facing text in ToneHop/Sources/Stores/AudioStore.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a device to switch output"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击设备以切换输出"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.confirm_airplay_receiver": {
      "comment": "User-facing text in ToneHop/Sources/Models/AudioCatalog.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming the AirPlay receiver. Select the device in the macOS Sound menu."
