    "audio.exit_check_unsupported": {
      "comment": "User-facing text in ToneHop/Sources/Stores/AudioStore.swift, ToneHop/Sources/Services/PrivateRouteService.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current audio service does not support checking cleanup before quitting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前音频服务不支持退出清理检查。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.exit_cleanup_unconfirmed": {
      "comment": "User-facing text in ToneHop/Sources/Services/AudioExitCoordinator.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup of the previous audio stream is not yet confirmed. The app will stay open. Try quitting again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧音频流尚未确认清理完成，应用保持运行，请稍后重试退出。"
          }
        }
      },
      "extractionState": "manual"
    },
    "audio.exit_not_prepared": {
      "comment": "User-facing text in ToneHop/Sources/Stores/AudioStore.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
