    },
    "audio.exit_output_unconfirmed": {
      "comment": "User-facing text in ToneHop/Sources/Services/AudioExitCoordinator.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switch to the built-in Mac speakers could not be confirmed. Quit cleanup was not performed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认输出已切换到 Mac 自带扬声器，未执行退出清理。"
          }
        }
      },
      "extractionState": "manual"
    },
