      "extractionState": "manual"
    },
    "audio.exit_stream_identity_incomplete": {
      "comment": "User-facing text in ToneHop/Sources/Services/PrivateRouteService.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
