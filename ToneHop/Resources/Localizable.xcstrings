      "extractionState": "manual"
    },
    "audio.exit_speakers_unconfirmed": {
      "comment": "User-facing text in ToneHop/Sources/Services/AudioExitCoordinator.swift. Device names and identifiers are inserted unchanged.",
      "localizations": {
        "en": {
